{
  "$schema": "https://aka.ms/terminal-profiles-schema",

  // Windows Terminal, translated from the Mac's ghostty/config.
  //
  // What did not port, recorded rather than omitted:
  //   font-thicken            a macOS antialiasing correction; the problem it
  //                           solves does not exist on Windows' rasteriser
  //   window-colorspace=p3    no counterpart
  //   background-blur=macos-glass  the nearest thing is useAcrylic, which is a
  //                           different material, not the same one renamed
  //   window-padding-color=extend  no counterpart
  //   minimum-contrast        WRONG when written, corrected here: the
  //                           counterpart exists and is spelled
  //                           adjustIndistinguishableColors. It is set in
  //                           profiles.defaults below. Confirmed in both
  //                           schemas/windows-terminal.json and the live
  //                           upstream schema before this line changed.
  //
  // Every other key below was confirmed against schemas/windows-terminal.json
  // before being written. check.sh re-confirms it on every run.
  //
  // defaultProfile names the profile rather than a GUID, and profiles.list
  // carries no WSL entry: Windows Terminal generates the WSL profile itself
  // (its dynamic profile generator is Windows.Terminal.Wsl) and derives that
  // profile's GUID from the distro name. A hand-written GUID here would point
  // at nothing, or worse, create a second, duplicate profile beside the real
  // one, with these appearance settings applied to the decoy while the
  // profile actually used stays default. Every appearance setting therefore
  // lives in profiles.defaults instead, which dynamically generated profiles
  // pick up without needing a GUID.

  "defaultProfile": "Ubuntu-26.04",

  // The tab row is the one surface the colour scheme does not reach: a
  // scheme paints the panes, never the chrome above them. Left unset it
  // renders in Windows' own grey, which is what makes an otherwise themed
  // terminal still read as a stock one.
  //
  // frame / unfocusedFrame would colour the window border too. They are
  // Windows Terminal Preview only, and this machine runs the stable
  // package (Microsoft.WindowsTerminal_8wekyb3d8bbwe), so they are absent
  // on purpose rather than forgotten. useMica is deliberately off: Mica
  // is drawn under the whole window including the panes, and cannot
  // coexist with the unblurred transparency profiles.defaults asks for.
  "theme": "Catppuccin",
  "themes": [
    {
      "name": "Catppuccin",
      "window": { "applicationTheme": "dark" },
      // mantle, one step darker than the panes' base. The tab row reads as
      // behind the terminal rather than beside it, which is what makes the
      // active tab look cut out of the window instead of stuck on it.
      "tabRow": { "background": "#181825", "unfocusedBackground": "#11111B" },
      // The active tab takes the pane's own background, so the seam between
      // tab and content disappears.
      "tab": {
        "background": "terminalBackground",
        "unfocusedBackground": "#00000000",
        // The distro logo is the only saturated colour in the chrome and it
        // competes with the content for attention. monochrome keeps the
        // shape, which is all the icon is being read for.
        "iconStyle": "monochrome",
        "showCloseButton": "activeOnly"
      }
    }
  ],
  "copyOnSelect": true,
  "copyFormatting": "none",

  "profiles": {
    "defaults": {
      "font": {
        // The same font as the Mac, and as VS Code below. check.sh asserts all
        // three agree and that exactly one Nerd Font is declared installed.
        "face": "JetBrainsMono Nerd Font",
        // 12, not Windows Terminal's default 12 by accident: this is a 100%-DPI
        // display (AppliedDPI 0x60), so the point size is the whole of the
        // apparent size and 14 read as oversized on it.
        "size": 12,
        // JetBrains Mono ships no `liga`; its ligatures live in `calt`.
        // `zero` slashes the zero -- the single highest-value feature in a
        // terminal, where 0 and O collide constantly in paths and hashes.
        // `ss02` is the font's "Closed construction": narrower apertures on
        // a/c/e/s. A letterform preference, unrelated to ligatures.
        "features": { "calt": 1, "zero": 1, "ss02": 1 },
        // An absolute override, not an adjustment: Microsoft's own schema
        // description says the unset default "is usually quite close to
        // setting this to 1.2". 120% therefore asks for roughly the font's
        // natural line height and nothing more.
        //
        // It was 134% -- that 1.2 composed with the Mac Ghostty's
        // adjust-cell-height = 12%. The Mac parity this file was built to keep
        // is no longer a requirement, and 34% of added leading is a lot of
        // vertical room to spend on a terminal that draws boxes and trees.
        // Confirmed present in schemas/windows-terminal.json
        // (font.cellHeight, a CSSLengthPercentage) before being written.
        "cellHeight": "120%"
      },
      // Canonical Catppuccin Mocha, unmodified. See the scheme below for why
      // it is canonical rather than tuned, and where the tuning went instead.
      "colorScheme": "Catppuccin Mocha",
      // Windows Terminal's counterpart to Ghostty's minimum-contrast, which
      // the header of this file used to say did not exist. "indexed" adjusts
      // only colours that came from the scheme -- which is every colour the
      // prompt, the statusline and git emit, since all of them speak 16-colour
      // ANSI on purpose. A net, not a design: the scheme below is expected to
      // pass on its own, and check.sh asserts that it does.
      "adjustIndistinguishableColors": "indexed",
      // Ghostty: window-padding-x = 18, window-padding-y = 14.
      // Order here is left, top, right, bottom.
      "padding": "18, 14, 18, 14",
      // Ghostty: background-opacity = 0.90. This scale is 0-100.
      // Unblurred opacity requires Windows 11, which this machine is.
      "opacity": 90,
      "useAcrylic": true,
      "cursorShape": "filledBox",
      // Ghostty: scrollback-limit = 100000000 bytes. This is a line count, so
      // it is not the same number expressed differently -- it is a different
      // unit, chosen to be generous rather than converted.
      "historySize": 100000,
      // Ghostty: unfocused-split-opacity = 0.6. Windows Terminal applies this
      // per window rather than per split, which is the closest thing it has.
      "unfocusedAppearance": { "opacity": 70 },
      // startingDirectory lives in defaults rather than on the Ubuntu profile,
      // and that is the only way to set it without a GUID: Windows Terminal
      // generates the WSL profile and derives its GUID from the distro name, so
      // there is no stable id to attach a per-profile setting to.
      //
      // Leaving it unset was not an option. The documented default is
      // %USERPROFILE%, which from inside Ubuntu is /mnt/c/Users/... -- the path
      // this entire design exists to keep work off, at 9-20x the cost on build
      // artifacts. Unset would not make that a mistake someone occasionally
      // makes; it would make it the default, in every new tab.
      //
      // Windows PowerShell overrides it back below. Its GUID is a fixed
      // built-in constant, not a generated one, so it can be named safely.
      //
      // This hardcodes the UNIX username `camilo`, created at Ubuntu's first
      // launch (Task 4 Step 4). If a different name is ever chosen, this line
      // is wrong and the terminal opens somewhere that does not exist.
      "startingDirectory": "\\\\wsl$\\Ubuntu-26.04\\home\\camilo"
    },
    "list": [
      {
        "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
        "name": "Windows PowerShell",
        "hidden": false,
        // Overrides profiles.defaults.startingDirectory back to the Windows
        // home: this is the one profile here meant to open on the Windows
        // side. Its GUID is a fixed built-in constant, not a generated one,
        // so it can be named safely.
        "startingDirectory": "%USERPROFILE%"
      },
      { "guid": "{0caa0dad-35be-5f56-a8ff-afceeeaa6101}", "name": "Command Prompt", "hidden": true }
    ]
  },

  "schemes": [
    {
      // Catppuccin Mocha, verbatim from catppuccin/windows-terminal. Nothing
      // here is local. That is the point, and it was learned the hard way.
      //
      // An earlier revision of this file moved three slots -- black to base,
      // brightBlack to overlay2, selectionBackground to surface1 -- to make
      // wsl/claude/statusline.sh clear WCAG AA without touching that file. It
      // worked there and broke elsewhere, because a 16-colour palette is not
      // this repo's private setting: it is the contract every TUI on the
      // machine reads. Two slots inverted their meaning. black became the
      // background colour exactly (1.00:1, so ANSI-black text vanished), and
      // brightBlack rose above brightWhite, so any application using it for
      // the subtle background it conventionally is drew light-on-light.
      // Claude Code was the one that got noticed: its dark-ansi theme paints
      // three panels on ansi:blackBright with ansi:whiteBright text, which
      // measured 1.27:1 -- a grey box with nothing legible in it.
      //
      // The rule that replaces the old rationale: a scheme guarantees exactly
      // one thing, that each of its colours is readable ON ITS OWN
      // BACKGROUND. Every ratio below is that measurement. It guarantees
      // nothing about colour-on-colour, so nothing in this repo may ask it
      // for a colour-on-colour pair -- see the note at the top of
      // wsl/claude/statusline.sh, which no longer does.
      //
      // Ratios are against this scheme's own background (#1E1E2E), computed
      // with the WCAG relative-luminance formula. check.sh recomputes them on
      // every run, so these numbers cannot quietly go stale.
      "name": "Catppuccin Mocha",

      "cursorColor": "#F5E0DC",
      // surface2. Default foreground over a selection: 4.62:1, clears AA.
      "selectionBackground": "#585B70",

      "background": "#1E1E2E",
      "foreground": "#CDD6F4",

      // surface1. In a dark scheme ANSI black is a subtle background, not
      // text; upstream places it one step above the background for exactly
      // that. adjustIndistinguishableColors is the net for anything that
      // prints text in it anyway.
      "black": "#45475A",
      "red": "#F38BA8",
      "green": "#A6E3A1",
      "yellow": "#F9E2AF",
      "blue": "#89B4FA",
      "purple": "#F5C2E7",
      "cyan": "#94E2D5",
      "white": "#BAC2DE",

      // surface2. This is the low-contrast slot by design -- 2.46:1 against
      // the background -- and that is what every application means when it
      // reaches for it, whether as a de-emphasised foreground or as a panel
      // fill one step off the background. Nothing in this repo prints text
      // that has to be read in it; check.sh enforces that.
      "brightBlack": "#585B70",
      "brightRed": "#F38BA8",
      "brightGreen": "#A6E3A1",
      "brightYellow": "#F9E2AF",
      "brightBlue": "#89B4FA",
      "brightPurple": "#F5C2E7",
      "brightCyan": "#94E2D5",
      // subtext0, and note that upstream puts it BELOW white (subtext1,
      // #BAC2DE): in this scheme brightWhite is the dimmer of the two light
      // slots, not the brighter. That inversion is Catppuccin's, not ours,
      // and it is load-bearing -- it is the only slot that is both clearly
      // de-emphasised and comfortably readable (7.37:1), which is what
      // statusline.sh uses for its labels. check.sh asserts the ordering so
      // that a future scheme cannot silently take it away.
      "brightWhite": "#A6ADC8"
    }
  ],

  // Shift+Enter inserts a line break instead of sending the message.
  // Essential for multi-line prompts in Claude Code, and the single
  // keybinding whose absence is noticed within a minute.
  //
  // The brief's draft put "keys" directly on the actions entry; the vendored
  // schema (schemas/windows-terminal.json) does not allow that -- an actions
  // item is a FullCommand, and "keys" is not one of its properties. The
  // schema splits an action from the key that triggers it: actions defines
  // the command under a stable id, keybindings binds a key chord to that id.
  "actions": [
    { "id": "User.sendInputNewline", "command": { "action": "sendInput", "input": "\n" } }
  ],
  "keybindings": [{ "id": "User.sendInputNewline", "keys": "shift+enter" }]
}
