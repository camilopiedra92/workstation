# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
#
# The Windows host, declared. This file is the counterpart of the Mac repo's
# Brewfile and it is not a compromise: WinGet Configuration is declarative,
# idempotent, official, and applied with one command.
#
# It declares five kinds of thing and nothing else. Four make the WSL layer
# reachable, visible or typeable: the subsystem, a terminal, a font, an editor.
# The fifth is the tools needed to author this repo -- shellcheck, shfmt and
# taplo -- which are a different job from running the environment, and are kept
# in their own group so the first list cannot quietly absorb them.
#
# The moment something belongs to neither job, that is the signal the boundary
# is being crossed for a bad reason. check.sh holds both lists.
#
# Naming: Microsoft's convention is ./.config/configuration.winget. The
# extension is kept, because that is what carries the schema association. The
# directory is not, because .config/ at the repo root would place the Windows
# layer outside the two-strata structure this repo is organised by.
#
# Apply:     winget configure .\windows\configuration.winget
# Validate:  winget configure validate .\windows\configuration.winget
#
# git is deliberately absent. All git work happens in WSL, where
# `gh auth setup-git` provides credentials, mirroring the Mac exactly. A
# host-side credential-manager bridge is the documented alternative and is
# rejected: it creates a cross-boundary dependency to solve a problem that does
# not exist once nothing on the host uses git.
properties:
  assertions:
    # WSL2 and the modern winget both require Windows 10 1809+; this machine is
    # Windows 11 build 26200. The floor is asserted rather than assumed so that
    # applying this on a different machine fails at the precondition instead of
    # halfway through an install.
    - resource: Microsoft.Windows.Developer/OsVersion
      directives:
        description: Require Windows 10 21H2 or newer
        allowPrerelease: true
      settings:
        MinVersion: '10.0.22000'

  resources:
    # ---- The substrate ----
    # Ubuntu 26.04 LTS: released April 2026, supported to 2031. The alternative,
    # 24.04, runs out in 2029. Unlike Node, Ubuntu LTS has no parity trap to
    # sidestep -- every LTS gets the same five years -- so the newest one simply
    # is the right one, with no date to revisit.
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: wsl
      directives:
        description: Install Windows Subsystem for Linux
        securityContext: elevated
      settings:
        id: Microsoft.WSL
        source: winget

    # Ubuntu 26.04 LTS is not in winget -- Canonical ships it through
    # `wsl --install`, and winget's newest is 24.04. It is declared here with the
    # inbox Script resource rather than downgraded to the version winget happens
    # to carry: 26.04 is supported to 2031, 24.04 only to 2029.
    #
    # TestScript is what keeps this idempotent, so `winget configure` re-run
    # changes nothing. WSL_UTF8 is not decoration: without it `wsl --list`
    # emits UTF-16LE, which PowerShell reads as text full of NUL bytes, and the
    # match below silently never succeeds -- reinstalling the distro on every
    # run while reporting success.
    - resource: PSDscResources/Script
      id: ubuntu
      dependsOn:
        - wsl
      directives:
        description: Install Ubuntu 26.04 LTS on WSL2
        allowPrerelease: true
        securityContext: elevated
      settings:
        GetScript: |
          $env:WSL_UTF8 = 1
          @{ Result = (wsl.exe --list --quiet) -join ',' }
        TestScript: |
          $env:WSL_UTF8 = 1
          $distros = wsl.exe --list --quiet
          [bool]($distros -contains 'Ubuntu-26.04')
        SetScript: |
          $env:WSL_UTF8 = 1
          wsl.exe --install -d Ubuntu-26.04 --no-launch

    # ---- The environment ----
    # Deliberately unpinned, and the reason is not laziness. All four update
    # themselves out of band -- through the Store and their own in-app updaters
    # -- so a `version` here would describe a state the machine contradicts
    # within days, and the manifest would be documenting a fiction.
    #
    # Worse if it were honoured: it would hold back security updates on the two
    # largest attack surfaces here, a browser-grade editor and a terminal.
    #
    # The two groups that ARE pinned are the ones that stay put: the authoring
    # tools, whose whole purpose is version parity with CI, and the font, which
    # does not self-update and whose version moves glyph metrics.

    # ---- The terminal ----
    # Replaces Ghostty, which does not run on Windows and is not on its roadmap.
    # The machine currently has 1.18.10301, several versions behind.
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: terminal
      directives:
        description: Install Windows Terminal
        securityContext: elevated
      settings:
        id: Microsoft.WindowsTerminal
        source: winget

    # ---- The font ----
    # Exactly one Nerd Font, and check.sh asserts that it is exactly one. Two
    # installed is not better than one: when something falls back, or a family
    # name is misspelled, a second Nerd Font lets it resolve to the wrong one and
    # still work, with glyphs that look subtly different and no way to tell why.
    #
    # Pinned because, unlike the three below it, nothing here self-updates it.
    # No expiry: it moves when a glyph problem makes it move, or deliberately,
    # not on a schedule.
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: font
      directives:
        description: Install JetBrainsMono Nerd Font
        securityContext: elevated
      settings:
        id: DEVCOM.JetBrainsMonoNerdFont
        source: winget
        version: "3.3.0"

    # ---- The editor ----
    # Installed on the host and used against WSL through Remote-WSL. That is the
    # supported model, and it is why settings.json splits in two: host-side
    # rendering here, toolchain-side settings in wsl/vscode/settings.json.
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: vscode
      directives:
        description: Install Visual Studio Code
        securityContext: elevated
      settings:
        id: Microsoft.VisualStudioCode
        source: winget

    # ---- Mac muscle memory ----
    # PowerToys is here for Keyboard Manager specifically, which Microsoft's own
    # Mac-to-Windows guide recommends for remapping Command-key habits.
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: powertoys
      directives:
        description: Install PowerToys
        securityContext: elevated
      settings:
        id: Microsoft.PowerToys
        source: winget

    # ---- Authoring tools ----
    # These do not belong to the environment; they belong to working on THIS
    # repo. check.sh runs them, the pre-commit hook runs check.sh, and CI runs
    # the same versions -- so host and CI reach the same verdict on the same
    # file, which is the only way a green tick means anything.
    #
    # They are a separate group from the four above on purpose. The host layer
    # declares what makes the WSL layer reachable; this is a different job. One
    # undifferentiated list is how a thin layer stops being thin.
    #
    # These three versions are the CI pins. They move together or they stop
    # meaning anything, so bump-tools.sh (Task 14) moves both in one pass --
    # never one by hand.
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: shellcheck
      directives:
        description: Install ShellCheck (matches the CI pin, 0.11.0)
      settings:
        id: koalaman.shellcheck
        source: winget
        version: "0.11.0"

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: shfmt
      directives:
        description: Install shfmt (matches the CI pin, 3.13.1)
      settings:
        id: mvdan.shfmt
        source: winget
        version: "3.13.1"

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: taplo
      directives:
        description: Install taplo (matches the CI pin, 0.10.0)
      settings:
        id: tamasfe.taplo
        source: winget
        version: "0.10.0"

  configurationVersion: 0.2.0
